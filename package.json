{
  "name": "opencode-skillz",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/plugin/index.d.ts",
      "import": "./dist/plugin/index.js"
    },
    "./core": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./rpc": {
      "types": "./dist/rpc.d.ts",
      "import": "./dist/rpc.js"
    },
    "./tui": {
      "types": "./dist/tui/index.d.ts",
      "import": "./dist/tui/index.js"
    }
  },
  "files": [
    "dist",
    "server.js",
    "rpc.js",
    "tui.js"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.24",
    "jsonc-parser": "3.3.1",
    "tar": "^7.5.0",
    "yaml": "^2.8.0",
    "yauzl": "^3.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@opencode/theme": "2.0.24",
    "@opentui/core": "0.5.14",
    "@types/node": "^22.0.0",
    "@types/yauzl": "^2.10.3",
    "fflate": "^0.8.2",
    "solid-js": "1.9.18",
    "typescript": "^5.9.0",
    "vitest": "^4.1.12"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.14",
    "solid-js": ">=1.9.0"
  },
  "overrides": {
    "@opencode/plugin": {
      "zod": "$zod"
    }
  }
}
